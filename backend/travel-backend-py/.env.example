SERPAPI_KEY=your_serpapi_key_here

# Leave REDIS_URL empty to use the built-in in-memory cache.
# Local Redis / Memurai:  redis://localhost:6379
# Upstash (cloud):        rediss://default:<password>@<host>:<port>
REDIS_URL=
MONTHLY_QUOTA=90
FLIGHTS_TTL_MINUTES=45
HOTELS_TTL_MINUTES=60
TRANSIT_TTL_MINUTES=30
TRIPADVISOR_TTL_MINUTES=120

# Google Gemini AI Studio API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# MySQL database for persistent API query history. Create this database in MySQL first.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=serp_travel
