  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Request Flow (Flight Search)",
      "items": [
        "End-user submits journey criteria via React SPA to /api/flights/search",
        "FastAPI routes to FlightService which checks cache first (TTL: 45 min)",
        "On cache miss, QuotaGuard verifies monthly allowance (< 90 calls/mo)",
        "SerpApiClient injects SERPAPI_KEY and calls SerpApi google_flights engine",
        "Results are parsed, normalized into unified schema, cached, and returned"
      ]
    },
    {
      "dot": "emerald",
      "title": "Multi-Engine Travel Services",
      "items": [
        "HotelService queries google_hotels; HotelRanking calculates composite scores",
        "TransitService queries google_maps_directions for transit routes & step timing",
        "FoodService queries google_maps local places with haversine distance filtering",
        "All services share the exact same Cache-first and QuotaGuard execution pipeline"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Cost Shield",
      "items": [
        "Client Zone: Zero credential exposure; browser never sees SerpApi credentials",
        "Backend Domain: SerpApiClient is the single egress point with key scrubbing in logs",
        "QuotaGuard acts as cost circuit breaker raising HTTP 429 when budget limit is met",
        "Fail-soft error handling converts upstream failures into informative responses"
      ]
    }
  ]
